{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "mock-jira-server.ts",
    "mock-jira-server.spec.ts",
    "mock-github-server.ts",
    "mock-github-server.spec.ts"
  ]
}
